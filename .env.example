# ===============================
# ECC Platform — Environment Vars
# ===============================
# Copy this file to .env (root) and fill in actual values.
# Never commit .env to git.

# ---- Database ----
DATABASE_URL="postgresql://ecc_user:ecc_password@localhost:5432/ecc_platform?schema=public"

# ---- Redis (untuk session & OTP cache) ----
REDIS_URL="redis://localhost:6379"

# ---- JWT ----
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ---- WhatsApp Cloud API (Meta) ----
# Daftar di https://developers.facebook.com/apps/, buat WhatsApp Business app
WA_CLOUD_API_TOKEN="EAAxxxxxx"
WA_PHONE_NUMBER_ID="1234567890"
WA_BUSINESS_ACCOUNT_ID="0987654321"
WA_API_VERSION="v20.0"
# Nama template OTP yang sudah disetujui Meta
WA_OTP_TEMPLATE_NAME="ecc_login_otp"
WA_OTP_TEMPLATE_LANGUAGE="id"

# ---- OTP Config ----
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=300        # 5 menit
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Face Recognition ----
# Threshold euclidean distance (0-1). Lebih rendah = lebih ketat
FACE_MATCH_THRESHOLD=0.5
# Model path untuk face-api.js (server-side)
FACE_MODELS_PATH="./packages/auth/face-models"

# ---- URLs ----
PORTAL_URL="http://localhost:3000"
CORE_API_URL="http://localhost:4000"
NEXT_PUBLIC_CORE_API_URL="http://localhost:4000"

# ---- CORS ----
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://portal.eccchurch.global"

# ---- Production URLs ----
# PORTAL_URL=https://portal.eccchurch.global
# CORE_API_URL=https://core-api.eccchurch.global

# ---- File Storage (VPS filesystem) ----
# Direktori absolut tempat foto profil disimpan.
# Dev:        ./uploads (relatif ke apps/core-api)
# Production: /var/lib/ecc/uploads  (pastikan permission rw untuk user yang menjalankan Node)
UPLOADS_DIR="./uploads"
# Max ukuran foto upload (bytes). Default 5 MB.
UPLOAD_MAX_BYTES=5242880

# ---- App ----
NODE_ENV="development"
LOG_LEVEL="info"
