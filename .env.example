# ===============================
# ECC Platform — Environment Vars
# ===============================
# Copy this file to .env (root) and fill in actual values.
# Never commit .env to git.

# ---- Database (PostgreSQL lokal via Homebrew) ----
DATABASE_URL="postgresql://ecc_user:ecc_password@localhost:5432/ecc_platform?schema=public"

# ---- JWT ----
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Access token TTL (short — client silent-refresh sebelum expire).
JWT_EXPIRES_IN="7d"
# Refresh token TTL — sliding window (extended saat rotate via POST /auth/refresh).
# 365d = practically permanent untuk user active bulanan.
# User idle > 365 hari → forced re-login.
# Set 3650d (10 tahun) untuk truly permanent (security concern kalau device leak).
JWT_REFRESH_EXPIRES_IN="365d"

# ---- WhatsApp — Fonnte (gateway lokal Indonesia) ----
# Daftar di https://fonnte.com, beli paket, dapatkan device token di dashboard.
FONNTE_TOKEN=""

# ---- OTP Config ----
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=300        # 5 menit
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Face Recognition ----
FACE_MATCH_THRESHOLD=0.5
FACE_MODELS_PATH="./packages/auth/face-models"

# ---- File Storage (VPS filesystem) ----
UPLOADS_DIR="./uploads"
UPLOAD_MAX_BYTES=5242880

# ---- Ports & URLs ----
# Portal Next.js: 3100, Core API Express: 4100
# (default lama 3000/4000 sering konflik dengan dev tools lain)
PORT=4100
PORTAL_URL="http://localhost:3100"
CORE_API_URL="http://localhost:4100"
NEXT_PUBLIC_CORE_API_URL="http://localhost:4100"

# ---- CORS ----
# Dev mode: app.ts auto-allow semua http://localhost:* origin (lihat src/app.ts)
# Prod mode: list eksplisit di sini, koma-separated.
CORS_ALLOWED_ORIGINS="http://localhost:3100,https://portal.eccchurch.global"

# ---- App ----
NODE_ENV="development"
LOG_LEVEL="info"

# ---- Liveness Nonce (face auth gate) ----
# Optional — fallback ke JWT_SECRET kalau tidak diset. Rekomendasi: pakai
# secret terpisah supaya rotasi independent. Min 32 chars.
LIVENESS_NONCE_SECRET=""

# ---- Credential Vault Master Password ----
# Wajib di-set untuk fitur Credential menu Developer Tools.
# Min 8 char, rekomendasi 20+ char random. Disebar HANYA ke admin level
# yang berhak akses vault. Rotasi = redeploy + edit .env di VPS.
# Generate: openssl rand -base64 24
CREDENTIAL_MASTER_PASSWORD=""

# ---- Scheduled Jobs ----
# Audit log retention (hari). Default 365. Set lebih kecil kalau compliance
# require lebih short.
AUDIT_LOG_RETENTION_DAYS=365

# WA reminder dispatch window — jam (server local, expected WIB).
# Reminder cuma di-kirim di jam ini supaya tidak pop notif tengah malam.
# Default 07:00–10:00 WIB.
REMINDER_SEND_HOUR_START=7
REMINDER_SEND_HOUR_END=10

# ---- Email (SendGrid) — untuk magic link login (module 24) ----
# Daftar di https://sendgrid.com (Free 100 email/hari).
# Setelah dapat API key, verifikasi sender email atau domain di
# SendGrid dashboard sebelum kirim.
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@eccchurch.global"
EMAIL_FROM_NAME="Elshaddai Creative Community"
# Deep link mobile — tautan magic link akan open mobile app kalau installed,
# fallback ke web URL kalau tidak.
EMAIL_MAGIC_LINK_MOBILE_URL="ecc://auth/email/verify"
EMAIL_MAGIC_LINK_WEB_URL="https://portal.eccchurch.global/auth/email/verify"
# TTL magic link — default 15 menit. Terlalu pendek = user bingung,
# terlalu panjang = risk hijack. 15 min = sweet spot.
MAGIC_LINK_TTL_MINUTES=15

# ---- Shiftsoft Legacy Migration ----
# Hash per-tenant untuk auth API shiftsoft.org — dipakai script
# packages/database/prisma/scripts/migrate-shiftsoft/. SECRETS, jangan commit.
# Dapat dari owner Shiftsoft. Format: base64url string yang tail =
# Tidak wajib di production (script cuma jalan on-demand, gak di runtime app).
SHIFTSOFT_HASH_ECCGLOBAL=""
SHIFTSOFT_HASH_ECCBANDUNG=""
SHIFTSOFT_HASH_ECCJAKARTA=""
SHIFTSOFT_HASH_ECCBALI=""
SHIFTSOFT_HASH_ECCMALANG=""
SHIFTSOFT_HASH_ECCSYDNEY=""
SHIFTSOFT_HASH_ECCKUALALUMPUR=""
SHIFTSOFT_HASH_ECCMAKASSAR=""
