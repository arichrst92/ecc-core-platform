# Hoist semua @types/* ke top-level node_modules supaya TypeScript bisa
# resolve via plain package name. Tanpa ini, types live di .pnpm subfolder
# dan TS error TS2742 ("The inferred type of X cannot be named without a
# reference to .pnpm/@types+express...") saat exporting symbol bertipe
# Router, ZodSchema, dll.
public-hoist-pattern[]=*types*
# Hoist eslint config + plugin juga (lint tooling tipikal expect root-level).
public-hoist-pattern[]=*eslint*
