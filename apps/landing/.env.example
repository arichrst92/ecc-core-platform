# =====================================================================
# ECC Landing — Environment (apps/landing/.env.local)
# =====================================================================
# Copy file ini ke `.env.local` di folder `apps/landing/`. Jangan commit
# .env.local ke git (sudah di-ignore root-level).
#
# Next.js HANYA membaca env dari folder app ini (atau .env.local di sini)
# — TIDAK dari root .env monorepo. Itu sebabnya kalau lo cuma punya env
# di root, landing akan fallback ke default production URL.
#
# Var ini NEXT_PUBLIC_* artinya di-bake saat `next build`. Setiap kali
# nilainya berubah, butuh restart `next dev` atau rebuild.
# =====================================================================

# ---- Backend Core API ----
# Local dev:
#   NEXT_PUBLIC_CORE_API_URL=http://localhost:4100
# VPS production (default kalau env ini tidak di-set):
#   NEXT_PUBLIC_CORE_API_URL=https://api.eccchurch.global
NEXT_PUBLIC_CORE_API_URL=http://localhost:4100
