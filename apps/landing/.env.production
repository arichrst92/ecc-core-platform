# =====================================================================
# ECC Landing — Production Environment
# =====================================================================
# Di-baca otomatis oleh `next build` ketika NODE_ENV=production.
# Override apa pun yang ada di apps/landing/.env atau root .env.
#
# CATATAN PENTING: NEXT_PUBLIC_* di-bake saat build, BUKAN runtime.
# Setiap kali nilai di file ini berubah, WAJIB rebuild landing di VPS:
#   pnpm --filter @ecc/landing build && pm2 reload ecc-landing
#
# File ini SAFE untuk di-commit (cuma public URL, no secrets).
# =====================================================================

# Backend Core API — production endpoint
NEXT_PUBLIC_CORE_API_URL=https://api.eccchurch.global
