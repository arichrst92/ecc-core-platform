{
  "name": "@ecc/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:register": "dotenv -e ../../.env -- tsx prisma/scripts/register-jemaat.ts",
    "db:update-nohp": "dotenv -e ../../.env -- tsx prisma/scripts/update-jemaat-nohp.ts",
    "db:migrate-shiftsoft": "dotenv -e ../../.env -- tsx prisma/scripts/migrate-shiftsoft/run.ts",
    "db:migrate-shiftsoft-groups": "dotenv -e ../../.env -- tsx prisma/scripts/migrate-shiftsoft/run-groups.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules/.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "dotenv-cli": "^7.4.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
