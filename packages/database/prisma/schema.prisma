// ============================================================
// ECC Church Master Data Platform — Prisma Schema
// ============================================================
// Generated: 2026-05-14
// Database: PostgreSQL
//
// Entitas dikelompokkan ke dalam 5 cluster:
//   1. Organisasi      : sinode, cabang_gereja, jemaat
//   2. Klasifikasi     : role, sub_role, sub_role_status, jemaat_role
//   3. Ibadah          : kategori_ibadah, ibadah
//   4. Keluarga        : tipe_relasi_keluarga, jemaat_relasi
//   5. Auth & API      : user, otp_verification, refresh_token, sinode_api_key
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. ORGANISASI
// ============================================================

model Sinode {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String   @db.VarChar(255)
  kode      String   @unique @db.VarChar(20)
  alamat    String?  @db.Text
  kontak    String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cabangGereja CabangGereja[]
  apiKeys      SinodeApiKey[]
  konten       Konten[]

  @@map("sinode")
}

model CabangGereja {
  id        String   @id @default(uuid()) @db.Uuid
  sinodeId  String   @map("sinode_id") @db.Uuid
  nama      String   @db.VarChar(255)
  kode      String   @db.VarChar(20)
  alamat    String?  @db.Text
  kontak    String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sinode         Sinode         @relation(fields: [sinodeId], references: [id], onDelete: Restrict)
  jemaat         Jemaat[]
  ibadah         Ibadah[]
  konten         Konten[]
  homecellAreas  HomecellArea[]

  @@unique([sinodeId, kode])
  @@index([sinodeId])
  @@map("cabang_gereja")
}

model Jemaat {
  id              String    @id @default(uuid()) @db.Uuid
  cabangId        String    @map("cabang_id") @db.Uuid
  namaLengkap     String    @map("nama_lengkap") @db.VarChar(255)
  email           String?   @unique @db.VarChar(255)
  noHp            String?   @unique @map("no_hp") @db.VarChar(20)
  tanggalLahir    DateTime? @map("tanggal_lahir") @db.Date
  jenisKelamin    JenisKelamin? @map("jenis_kelamin")
  alamat          String?   @db.Text
  tanggalBergabung DateTime? @map("tanggal_bergabung") @db.Date
  // Foto profil resmi jemaat (untuk kartu jemaat, direktori, dll).
  // Relative path di VPS filesystem, mis. "/uploads/profiles/jemaat/{uuid}.webp"
  fotoUrl         String?   @map("foto_url") @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cabang                  CabangGereja              @relation(fields: [cabangId], references: [id], onDelete: Restrict)
  jemaatRoles             JemaatRole[]
  relasiAsal              JemaatRelasi[]            @relation("RelasiAsal")
  relasiTujuan            JemaatRelasi[]            @relation("RelasiTujuan")
  user                    User?
  jemaatPelayanan         JemaatPelayanan[]
  ibadahPelayananPetugas  IbadahPelayananPetugas[]
  reservasi               Reservasi[]
  areaPic                 HomecellArea[]            @relation("AreaPic")
  homecellPic             Homecell[]                @relation("HomecellPic")
  homecellMembership      HomecellMember[]          @relation("HomecellMembership")

  @@index([cabangId])
  @@index([noHp])
  @@index([namaLengkap])
  @@map("jemaat")
}

enum JenisKelamin {
  L
  P

  @@map("jenis_kelamin")
}

// ============================================================
// 2. KLASIFIKASI PERAN (Global, lintas sinode)
// ============================================================

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String   @unique @db.VarChar(100)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subRoles    SubRole[]
  jemaatRoles JemaatRole[]

  @@map("role")
}

model SubRole {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  nama      String   @db.VarChar(100)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role        Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  statuses    SubRoleStatus[]
  jemaatRoles JemaatRole[]

  @@unique([roleId, nama])
  @@index([roleId])
  @@map("sub_role")
}

model SubRoleStatus {
  id        String   @id @default(uuid()) @db.Uuid
  subRoleId String   @map("sub_role_id") @db.Uuid
  nama      String   @db.VarChar(100)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subRole     SubRole      @relation(fields: [subRoleId], references: [id], onDelete: Cascade)
  jemaatRoles JemaatRole[]

  @@unique([subRoleId, nama])
  @@index([subRoleId])
  @@map("sub_role_status")
}

// Junction many-to-many: jemaat ↔ role (dengan riwayat)
model JemaatRole {
  id               String    @id @default(uuid()) @db.Uuid
  jemaatId         String    @map("jemaat_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  subRoleId        String    @map("sub_role_id") @db.Uuid
  subRoleStatusId  String?   @map("sub_role_status_id") @db.Uuid
  tanggalMulai     DateTime  @default(now()) @map("tanggal_mulai") @db.Date
  tanggalSelesai   DateTime? @map("tanggal_selesai") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  catatan          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  jemaat         Jemaat         @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  subRole        SubRole        @relation(fields: [subRoleId], references: [id], onDelete: Restrict)
  subRoleStatus  SubRoleStatus? @relation(fields: [subRoleStatusId], references: [id], onDelete: SetNull)

  @@index([jemaatId])
  @@index([roleId])
  @@index([isActive])
  @@map("jemaat_role")
}

// ============================================================
// 3. IBADAH
// ============================================================

model KategoriIbadah {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String   @unique @db.VarChar(100)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ibadah Ibadah[]

  @@map("kategori_ibadah")
}

model Ibadah {
  id                String       @id @default(uuid()) @db.Uuid
  cabangId          String       @map("cabang_id") @db.Uuid
  kategoriIbadahId  String       @map("kategori_ibadah_id") @db.Uuid
  nama              String       @db.VarChar(255)
  tipeJadwal        TipeJadwal   @map("tipe_jadwal")
  tanggalMulai      DateTime     @map("tanggal_mulai") @db.Date
  hari              HariMinggu?  // diisi untuk weekly/biweekly
  jamMulai          String       @map("jam_mulai") @db.VarChar(5)  // HH:mm
  jamSelesai        String       @map("jam_selesai") @db.VarChar(5)
  lokasi            String?      @db.Text
  isOnline          Boolean      @default(false) @map("is_online")
  linkStream        String?      @map("link_stream") @db.Text
  deskripsi         String?      @db.Text
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  cabang           CabangGereja      @relation(fields: [cabangId], references: [id], onDelete: Restrict)
  kategoriIbadah   KategoriIbadah    @relation(fields: [kategoriIbadahId], references: [id], onDelete: Restrict)
  ibadahPelayanan  IbadahPelayanan[]
  reservasi        Reservasi[]

  @@index([cabangId])
  @@index([kategoriIbadahId])
  @@map("ibadah")
}

enum TipeJadwal {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ONCE     // Ibadah sekali (event one-time, mis. KKR, ibadah Natal khusus)

  @@map("tipe_jadwal")
}

enum HariMinggu {
  MINGGU
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU

  @@map("hari_minggu")
}

// ============================================================
// 4. RELASI KELUARGA
// ============================================================

model TipeRelasiKeluarga {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String   @unique @db.VarChar(50)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jemaatRelasi JemaatRelasi[]

  @@map("tipe_relasi_keluarga")
}

// Self-referencing relasi antar jemaat (satu arah, bisa di-hard-delete)
model JemaatRelasi {
  id              String   @id @default(uuid()) @db.Uuid
  jemaatId        String   @map("jemaat_id") @db.Uuid
  jemaatTerkaitId String   @map("jemaat_terkait_id") @db.Uuid
  tipeRelasiId    String   @map("tipe_relasi_id") @db.Uuid
  keterangan      String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  jemaat        Jemaat             @relation("RelasiAsal", fields: [jemaatId], references: [id], onDelete: Cascade)
  jemaatTerkait Jemaat             @relation("RelasiTujuan", fields: [jemaatTerkaitId], references: [id], onDelete: Cascade)
  tipeRelasi    TipeRelasiKeluarga @relation(fields: [tipeRelasiId], references: [id], onDelete: Restrict)

  @@unique([jemaatId, jemaatTerkaitId, tipeRelasiId])
  @@index([jemaatId])
  @@index([jemaatTerkaitId])
  @@map("jemaat_relasi")
}

// ============================================================
// 5. AUTH & API
// ============================================================

// User table untuk autentikasi.
// Auth ini dipakai SEMUA jemaat (bukan hanya fulltimer) — karena
// sistem auth ini akan dikonsumsi aplikasi lain di ekosistem ECC.
// Akses ke portal admin tetap di-gate via role check (harus Fulltimer).
model User {
  id              String    @id @default(uuid()) @db.Uuid
  jemaatId        String    @unique @map("jemaat_id") @db.Uuid
  // Avatar untuk akun login. Bisa beda dari jemaat.fotoUrl (foto resmi jemaat).
  // Disimpan sebagai relative path di VPS filesystem, mis. "/uploads/profiles/user/{uuid}.webp"
  fotoUrl         String?   @map("foto_url") @db.Text
  faceDescriptor  Json?     @map("face_descriptor")    // 128-dim Float32 vector dari face-api.js
  faceEnrolledAt  DateTime? @map("face_enrolled_at")
  lastLoginAt     DateTime? @map("last_login_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  jemaat        Jemaat         @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  authoredKonten Konten[]

  @@map("user")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  noHp       String     @map("no_hp") @db.VarChar(20)
  kodeHash   String     @map("kode_hash") @db.VarChar(255)  // hash bcrypt dari OTP
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  usedAt     DateTime?  @map("used_at")
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  userAgent  String?    @map("user_agent") @db.Text
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([noHp, purpose])
  @@index([expiresAt])
  @@map("otp_verification")
}

enum OtpPurpose {
  LOGIN
  ENROLLMENT
  RESET_FACE

  @@map("otp_purpose")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

// API key untuk aplikasi konsumen di core-api.eccchurch.global
// Scoped per sinode supaya satu aplikasi hanya akses data sinode-nya.
model SinodeApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  sinodeId    String    @map("sinode_id") @db.Uuid
  nama        String    @db.VarChar(255)            // deskripsi konsumen, mis. "Mobile App Sinode A"
  keyHash     String    @unique @map("key_hash") @db.VarChar(255)
  keyPrefix   String    @map("key_prefix") @db.VarChar(20)   // 8-12 char prefix untuk display
  scopes      String[]  @default([])                // ["read:jemaat","read:ibadah",...]
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sinode Sinode @relation(fields: [sinodeId], references: [id], onDelete: Cascade)

  @@index([sinodeId])
  @@index([keyPrefix])
  @@map("sinode_api_key")
}

// ============================================================
// 6. AUDIT LOG
// ============================================================
// Catatan semua operasi CUD pada master data + event auth penting.
// Denormalisasi userName / resourceLabel disengaja: jika user/resource
// nanti dihapus, log tetap readable untuk audit historis.
// Default retention 365 hari (jalankan cron untuk purge yang lebih lama).
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  userName      String?     @map("user_name") @db.VarChar(255)
  action        AuditAction
  resource      String      @db.VarChar(100)     // 'jemaat', 'sinode', 'auth', dst.
  resourceId    String?     @map("resource_id") @db.Uuid
  resourceLabel String?     @map("resource_label") @db.VarChar(500)
  before        Json?       // state sebelum (UPDATE/DELETE)
  after         Json?       // state sesudah (CREATE/UPDATE)
  metadata      Json?
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ENROLL_FACE
  RESET_FACE
  UPLOAD_PHOTO

  @@map("audit_action")
}

// ============================================================
// 7. PELAYANAN (Ministry — operasional)
// ============================================================
// Pelayanan adalah tim ministry operasional (Multimedia, Worship, Usher, dll).
// Berbeda dengan role/sub_role (Jemaat/Volunteer/Fulltimer — klasifikasi
// keanggotaan), pelayanan menggambarkan struktur tim yang aktif melayani
// di ibadah tertentu.
//
// Struktur:
//   - Pelayanan (master, global): Multimedia, Worship, Usher
//   - PelayananRole (per-pelayanan): Multimedia → Leader/Camera/Sound;
//     Worship → Leader/Vocalist/Musician
//   - JemaatPelayanan: junction M:N + role + riwayat
//   - IbadahPelayanan: junction M:N — pelayanan ini melayani di ibadah mana
// ============================================================

model Pelayanan {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String   @unique @db.VarChar(100)
  deskripsi String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles            PelayananRole[]
  jemaatPelayanan  JemaatPelayanan[]
  ibadahPelayanan  IbadahPelayanan[]

  @@map("pelayanan")
}

model PelayananRole {
  id           String   @id @default(uuid()) @db.Uuid
  pelayananId  String   @map("pelayanan_id") @db.Uuid
  nama         String   @db.VarChar(100)
  deskripsi    String?  @db.Text
  // Urutan hierarki untuk display + permission check (Leader=10, Member=0).
  // Higher = senior. Bebas didefinisikan per pelayanan.
  level        Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pelayanan               Pelayanan                 @relation(fields: [pelayananId], references: [id], onDelete: Cascade)
  jemaatPelayanan         JemaatPelayanan[]
  ibadahPelayananPetugas  IbadahPelayananPetugas[]

  @@unique([pelayananId, nama])
  @@index([pelayananId])
  @@map("pelayanan_role")
}

// Junction Jemaat <-> Pelayanan dengan role + riwayat
model JemaatPelayanan {
  id              String    @id @default(uuid()) @db.Uuid
  jemaatId        String    @map("jemaat_id") @db.Uuid
  pelayananId    String    @map("pelayanan_id") @db.Uuid
  pelayananRoleId String   @map("pelayanan_role_id") @db.Uuid
  tanggalMulai    DateTime  @default(now()) @map("tanggal_mulai") @db.Date
  tanggalSelesai  DateTime? @map("tanggal_selesai") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  catatan         String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  jemaat        Jemaat        @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  pelayanan     Pelayanan     @relation(fields: [pelayananId], references: [id], onDelete: Restrict)
  pelayananRole PelayananRole @relation(fields: [pelayananRoleId], references: [id], onDelete: Restrict)

  @@index([jemaatId])
  @@index([pelayananId])
  @@index([isActive])
  @@map("jemaat_pelayanan")
}

// Junction Ibadah <-> Pelayanan (M:N — pelayanan ini melayani di ibadah mana)
model IbadahPelayanan {
  id           String   @id @default(uuid()) @db.Uuid
  ibadahId     String   @map("ibadah_id") @db.Uuid
  pelayananId  String   @map("pelayanan_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  ibadah    Ibadah                    @relation(fields: [ibadahId], references: [id], onDelete: Cascade)
  pelayanan Pelayanan                 @relation(fields: [pelayananId], references: [id], onDelete: Cascade)
  petugas   IbadahPelayananPetugas[]

  @@unique([ibadahId, pelayananId])
  @@index([ibadahId])
  @@index([pelayananId])
  @@map("ibadah_pelayanan")
}

// ============================================================
// 8. KEHADIRAN / RESERVASI IBADAH
// ============================================================
// Reservasi jemaat untuk hadir di ibadah pada tanggal tertentu.
// Karena ibadah recurring (mis. Ibadah Pemuda setiap Sabtu), kita track
// `tanggal_ibadah` spesifik per reservasi.
//
// Workflow:
//   1. Jemaat reservasi → status RESERVE → dapat kode (UUID short / random)
//   2. Saat hadir → mobile scanner scan kode → status JOIN, set joined_at
//   3. Kalau batal → status CANCEL, set cancelled_at
//
// Constraint: unique(jemaat_id, ibadah_id, tanggal_ibadah) supaya tidak bisa
// double-reserve untuk ibadah+tanggal yang sama.
// ============================================================

model Reservasi {
  id              String          @id @default(uuid()) @db.Uuid
  jemaatId        String          @map("jemaat_id") @db.Uuid
  ibadahId        String          @map("ibadah_id") @db.Uuid
  // Tanggal occurrence ibadah (penting karena ibadah recurring)
  tanggalIbadah   DateTime        @map("tanggal_ibadah") @db.Date
  status          ReservasiStatus @default(RESERVE)
  // Kode unik untuk barcode/QR — generate alphanumeric pendek (mis. "R7K2X9P")
  kode            String          @unique @db.VarChar(20)
  // Timestamps perubahan status
  reservedAt      DateTime        @default(now()) @map("reserved_at")
  joinedAt        DateTime?       @map("joined_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  catatan         String?         @db.Text
  // Metadata: siapa yang trigger checkin (mobile app scan, manual admin, dll)
  checkedInBy     String?         @map("checked_in_by") @db.Uuid  // userId yang scan
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  jemaat Jemaat @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  ibadah Ibadah @relation(fields: [ibadahId], references: [id], onDelete: Cascade)

  @@unique([jemaatId, ibadahId, tanggalIbadah])
  @@index([ibadahId, tanggalIbadah])
  @@index([jemaatId])
  @@index([status])
  @@index([kode])
  @@map("reservasi")
}

enum ReservasiStatus {
  RESERVE
  JOIN
  CANCEL

  @@map("reservasi_status")
}

// ============================================================
// 9. KONTEN BROADCAST (News & Renungan)
// ============================================================
// Konten yang dipublish ke jemaat via mobile app.
// Satu tabel `konten` dengan `tipe` enum NEWS / RENUNGAN — banyak field
// overlap (judul, ringkasan, konten, hero image, author, target audience).
//
// Targeting (audience scope):
//   - sinodeId = null, cabangId = null  → global (semua sinode + cabang)
//   - sinodeId = X,    cabangId = null  → sinode-wide (semua cabang di sinode X)
//   - sinodeId = X,    cabangId = Y     → cabang-specific (cabang Y di sinode X)
//
// Field renungan-spesifik (tanggal, ayat_alkitab) nullable untuk News.
// ============================================================

model Konten {
  id           String     @id @default(uuid()) @db.Uuid
  tipe         KontenTipe
  judul        String     @db.VarChar(255)
  // URL-friendly slug, unique global supaya bisa dipakai di public mobile url
  slug         String     @unique @db.VarChar(280)
  ringkasan    String?    @db.Text                                 // short preview
  konten       String     @db.Text                                 // markdown body
  heroImageUrl String?    @map("hero_image_url") @db.Text          // /uploads/content/hero/{id}.webp

  // Audience scope
  sinodeId     String?    @map("sinode_id") @db.Uuid
  cabangId     String?    @map("cabang_id") @db.Uuid

  // Renungan-spesifik (opsional, biasanya null untuk NEWS)
  tanggal      DateTime?  @db.Date                                 // tanggal renungan ditujukan
  ayatAlkitab  String?    @map("ayat_alkitab") @db.VarChar(255)    // mis. "Yohanes 3:16"

  // Tags (PostgreSQL array)
  tags         String[]   @default([])

  // Publishing
  isPublished  Boolean    @default(false) @map("is_published")
  publishedAt  DateTime?  @map("published_at")

  // Stats
  viewCount    Int        @default(0) @map("view_count")

  // Author
  authorId     String     @map("author_id") @db.Uuid

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  author User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sinode Sinode?       @relation(fields: [sinodeId], references: [id], onDelete: Cascade)
  cabang CabangGereja? @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@index([tipe])
  @@index([sinodeId])
  @@index([cabangId])
  @@index([isPublished, publishedAt])
  @@index([tanggal])
  @@index([slug])
  @@map("konten")
}

enum KontenTipe {
  NEWS
  RENUNGAN

  @@map("konten_tipe")
}

// ============================================================
// 10. COMMUNITY — Homecell Area & Homecell
// ============================================================
// Struktur penggembalaan:
//   CabangGereja
//     └── HomecellArea (zone)
//           └── Homecell (cellgroup)
//                 └── HomecellMember (junction M:N dengan Jemaat)
//
// PIC constraint (business rule, validasi di backend):
//   - HomecellArea.picJemaat HARUS punya active JemaatPelayanan
//     dengan Pelayanan="Penggembalaan" + Role="Zone Leader"
//   - Homecell.picJemaat HARUS Pelayanan="Penggembalaan" + Role="Homecell Leader"
// ============================================================

model HomecellArea {
  id           String       @id @default(uuid()) @db.Uuid
  cabangId     String       @map("cabang_id") @db.Uuid
  nama         String       @db.VarChar(100)
  deskripsi    String?      @db.Text
  // PIC (Zone Leader) — nullable supaya area bisa dibuat dulu sebelum assign
  picJemaatId  String?      @map("pic_jemaat_id") @db.Uuid
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  cabang     CabangGereja @relation(fields: [cabangId], references: [id], onDelete: Restrict)
  picJemaat  Jemaat?      @relation("AreaPic", fields: [picJemaatId], references: [id], onDelete: SetNull)
  homecells  Homecell[]

  @@unique([cabangId, nama])
  @@index([cabangId])
  @@index([picJemaatId])
  @@map("homecell_area")
}

model Homecell {
  id           String       @id @default(uuid()) @db.Uuid
  areaId       String       @map("area_id") @db.Uuid
  nama         String       @db.VarChar(150)
  deskripsi    String?      @db.Text
  alamat       String?      @db.Text                       // lokasi pertemuan
  hari         HariMinggu?                                  // jadwal hari pertemuan
  jam          String?      @db.VarChar(5)                  // HH:mm
  picJemaatId  String?      @map("pic_jemaat_id") @db.Uuid
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  area       HomecellArea     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  picJemaat  Jemaat?          @relation("HomecellPic", fields: [picJemaatId], references: [id], onDelete: SetNull)
  members    HomecellMember[]

  @@index([areaId])
  @@index([picJemaatId])
  @@map("homecell")
}

model HomecellMember {
  id               String    @id @default(uuid()) @db.Uuid
  homecellId       String    @map("homecell_id") @db.Uuid
  jemaatId         String    @map("jemaat_id") @db.Uuid
  tanggalBergabung DateTime  @default(now()) @map("tanggal_bergabung") @db.Date
  tanggalKeluar    DateTime? @map("tanggal_keluar") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  catatan          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  homecell Homecell @relation(fields: [homecellId], references: [id], onDelete: Cascade)
  jemaat   Jemaat   @relation("HomecellMembership", fields: [jemaatId], references: [id], onDelete: Cascade)

  @@unique([homecellId, jemaatId])
  @@index([homecellId])
  @@index([jemaatId])
  @@map("homecell_member")
}

// 3-way junction: Ibadah × Pelayanan × Jemaat — siapa bertugas di pelayanan
// tertentu di ibadah tertentu, dengan role spesifik.
//
// Contoh: Ibadah Pemuda → Multimedia → Jason (Camera), Rahmat (Sound)
//
// Constraint:
//   - Unique pada (ibadah_pelayanan_id, jemaat_id): satu jemaat hanya 1 role
//     per ibadah-pelayanan combo (kalau mau dual role, buat 2 link pelayanan).
//   - Validasi backend: pelayananRoleId harus belong ke pelayanan dari
//     ibadahPelayanan (Multimedia role di Multimedia, bukan di Worship).
//   - Default tidak ada history per-date (assignment persistent untuk semua
//     occurrence ibadah recurring). Untuk schedule rotation per-date, butuh
//     extension dengan tabel attendance/schedule terpisah.
model IbadahPelayananPetugas {
  id                String   @id @default(uuid()) @db.Uuid
  ibadahPelayananId String   @map("ibadah_pelayanan_id") @db.Uuid
  jemaatId          String   @map("jemaat_id") @db.Uuid
  pelayananRoleId   String   @map("pelayanan_role_id") @db.Uuid
  catatan           String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  ibadahPelayanan IbadahPelayanan @relation(fields: [ibadahPelayananId], references: [id], onDelete: Cascade)
  jemaat          Jemaat          @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  pelayananRole   PelayananRole   @relation(fields: [pelayananRoleId], references: [id], onDelete: Restrict)

  @@unique([ibadahPelayananId, jemaatId])
  @@index([ibadahPelayananId])
  @@index([jemaatId])
  @@map("ibadah_pelayanan_petugas")
}
